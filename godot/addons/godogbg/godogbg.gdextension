windows.release.x86_64 = "res://addons/godogbg/bin/libgodogbg.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://addons/godogbg/bin/libgodogbg.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/godogbg/bin/libgodogbg.android.template_release.arm64.so"
